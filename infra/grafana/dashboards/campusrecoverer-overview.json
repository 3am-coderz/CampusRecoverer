{
  "id": null,
  "uid": "campusrecoverer-overview",
  "title": "CampusRecoverer Services",
  "tags": ["campusrecoverer", "prometheus", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "description": "HTTP requests per second, grouped by route template and status. Route labels never contain item IDs or query values.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum by (route, status_code) (rate(campus_api_http_requests_total[5m]))", "legendFormat": "{{route}} {{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API 5xx error rate",
      "description": "Share of API requests returning server errors over the last five minutes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(campus_api_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(campus_api_http_requests_total[5m])), 0.001)", "legendFormat": "5xx %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 response time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(campus_api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API availability",
      "description": "Prometheus scrape health for the API metrics listener.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "refId": "A", "expr": "up{job=\"api\"}", "legendFormat": "API" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Matching request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [{ "refId": "A", "expr": "sum by (route, status_code) (rate(campus_matching_http_requests_total[5m]))", "legendFormat": "{{route}} {{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Matching p95 response time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 13 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(campus_matching_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Matching 5xx error rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 13 },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(campus_matching_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(campus_matching_http_requests_total[5m])), 0.001)", "legendFormat": "5xx %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Matching availability",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 21 },
      "targets": [{ "refId": "A", "expr": "up{job=\"matching\"}", "legendFormat": "Matching" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "PostgreSQL active connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 21 },
      "targets": [{ "refId": "A", "expr": "pg_stat_database_numbackends{datname=\"campus_recoverer\"}", "legendFormat": "active connections" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "PostgreSQL transactions / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 21 },
      "targets": [{ "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"campus_recoverer\"}[5m]))", "legendFormat": "commits/s" }, { "refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"campus_recoverer\"}[5m]))", "legendFormat": "rollbacks/s" }],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "PostgreSQL buffer cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 21 },
      "targets": [{ "refId": "A", "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=\"campus_recoverer\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"campus_recoverer\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"campus_recoverer\"}[5m])), 0.001)", "legendFormat": "hit ratio" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 98 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "center" }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PostgreSQL deadlocks / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "targets": [{ "refId": "A", "expr": "sum(rate(pg_stat_database_deadlocks{datname=\"campus_recoverer\"}[5m]))", "legendFormat": "deadlocks/s" }],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "PostgreSQL exporter / DB availability",
      "description": "Prometheus scrape health and exporter-to-database connection health.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "targets": [{ "refId": "A", "expr": "up{job=\"postgres\"}", "legendFormat": "Exporter target" }, { "refId": "B", "expr": "pg_up", "legendFormat": "PostgreSQL connection" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    }
  ],
  "annotations": { "list": [] },
  "links": []
}
