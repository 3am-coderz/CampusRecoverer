# Copy this file to .env and replace every CHANGE_ME value before starting Docker.
POSTGRES_USER=postgres
POSTGRES_DB=campus_recoverer
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/campus_recoverer

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
INTERNAL_API_KEY=CHANGE_ME_MATCHING_SERVICE_KEY
HANDOVER_SECRET=CHANGE_ME_LONG_RANDOM_HANDOVER_SECRET
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prototype: no post-verification hold. Security desk check-in and verification still apply.
WAITING_PERIOD_LOW_HOURS=0
WAITING_PERIOD_MEDIUM_HOURS=0
WAITING_PERIOD_HIGH_HOURS=0

POSTGRES_EXPORTER_USER=campus_metrics
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME_EXPORTER_PASSWORD

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
